export function convertPixivEmojis(text: string): string {
  if (!text) return '';
  return text.replace(/\((\w+)\)/g, (_match: string, keyword: string): string => {
    const emoji: string | undefined = PIXIV_EMOJI_MAP.get(keyword);
    return emoji !== undefined ? emoji : _match;
  });
}
